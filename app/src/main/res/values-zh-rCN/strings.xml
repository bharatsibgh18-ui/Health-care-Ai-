    <!-- Red Flag Items -->
    <string name="emergency_sign_chest_title">剧烈胸痛</string>
    <string name="emergency_sign_chest_desc">压榨性疼痛并放射至手臂、肩膀、颈部或下颌。</string>
    <string name="emergency_sign_breath_title">突发呼吸困难</string>
    <string name="emergency_sign_breath_desc">喘不过气或无法完整说出一句话。</string>
    <string name="emergency_sign_stroke_title">中风征兆 (FAST)</string>
    <string name="emergency_sign_stroke_desc">面部歪斜、手臂无力或言语含糊不清。</string>
    <string name="emergency_sign_headache_title">突发剧烈头痛</string>
    <string name="emergency_sign_headache_desc">数秒内达到难以忍受程度的头痛。</string>
    <string name="emergency_sign_bleeding_title">严重出血或咳血</string>
    <string name="emergency_sign_bleeding_desc">无法控制的出血。</string>
    <string name="emergency_sign_allergy_title">严重过敏反应</string>
    <string name="emergency_sign_allergy_desc">嘴唇或舌头肿胀、喘息、荨麻疹或头晕。</string>

    <!-- FAST Stroke Protocol -->
    <string name="emergency_fast_header">🧠 F.A.S.T. 中风快速评估</string>
    <string name="emergency_fast_f_title">F - 面部 (Face)</string>
    <string name="emergency_fast_f_desc">请对方微笑，观察一侧面部是否下垂。</string>
    <string name="emergency_fast_a_title">A - 手臂 (Arms)</string>
    <string name="emergency_fast_a_desc">请对方抬起双臂，观察一侧是否无力下垂。</string>
    <string name="emergency_fast_s_title">S - 语言 (Speech)</string>
    <string name="emergency_fast_s_desc">请对方重复简单句子，观察是否吐字不清。</string>
    <string name="emergency_fast_t_title">T - 时间 (Time)</string>
    <string name="emergency_fast_t_desc">时间就是生命！请立即拨打 112/108。</string>

    <!-- First Aid Protocol -->
    <string name="emergency_first_aid_header">🩹 急救指导</string>
    <string name="emergency_fa_heart_title">• 胸痛 / 疑似心脏病发作：</string>
    <string name="emergency_fa_heart_desc">屈膝靠背坐直，松开紧身衣物并保持冷静等待救援。</string>
    <string name="emergency_fa_allergy_title">• 严重过敏反应 (Anaphylaxis)：</string>
    <string name="emergency_fa_allergy_desc">如有处方肾上腺素笔 (EpiPen)，立即注射于大腿外侧。</string>
    <string name="emergency_fa_unconscious_title">• 昏迷但呼吸正常：</string>
    <string name="emergency_fa_unconscious_desc">将其置于侧卧复原体位保持气道畅通并持续观察呼吸。</string>

