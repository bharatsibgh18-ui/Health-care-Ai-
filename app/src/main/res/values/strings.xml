    <!-- Emergency Protocol -->
    <string name="emergency_protocol_title">Emergency Protocol</string>
    <string name="emergency_alert_title">EMERGENCY RED FLAG ALERT</string>
    <string name="emergency_alert_desc">Potentially life-threatening symptoms detected. Seek emergency medical care immediately.</string>
    <string name="emergency_dispatch_title">Immediate Emergency Dispatch</string>
    <string name="emergency_dispatch_desc">If someone is in critical distress, do not delay. Tap below to place an immediate emergency call.</string>
    <string name="emergency_call_112">112 Universal</string>
    <string name="emergency_call_108">108 Ambulance</string>
    <string name="emergency_call_104">104 Health Helpline</string>
    <string name="emergency_send_gps_sos">🚨 Send Live GPS SOS SMS to Contact</string>
    <string name="emergency_sending_gps_sos">Fetching GPS &amp; Sending SOS...</string>
    <string name="emergency_call_contact_format">Call %1$s (%2$s)</string>
    <string name="emergency_red_flags_header">🚨 Life-Threatening Red Flags</string>
    <string name="emergency_red_flags_sub">Stop triage and seek emergency room care immediately if you notice any of these signs:</string>
    
    <!-- Red Flag Items -->
    <string name="emergency_sign_chest_title">Severe Chest Pain</string>
    <string name="emergency_sign_chest_desc">Crushing, squeezing pain radiating to arm, shoulder, neck, or jaw.</string>
    <string name="emergency_sign_breath_title">Sudden Shortness of Breath</string>
    <string name="emergency_sign_breath_desc">Gasping, choking, or inability to complete a full sentence.</string>
    <string name="emergency_sign_stroke_title">Signs of Stroke (FAST)</string>
    <string name="emergency_sign_stroke_desc">Face drooping, sudden arm weakness, or slurred/incoherent speech.</string>
    <string name="emergency_sign_headache_title">Thunderclap Headache</string>
    <string name="emergency_sign_headache_desc">Sudden, excruciating headache peaking within seconds.</string>
    <string name="emergency_sign_bleeding_title">Severe Bleeding or Coughing Blood</string>
    <string name="emergency_sign_bleeding_desc">Uncontrolled hemorrhage or hemoptysis.</string>
    <string name="emergency_sign_allergy_title">Anaphylaxis Signs</string>
    <string name="emergency_sign_allergy_desc">Swollen lips/tongue, wheezing, hives, dizziness after food or sting.</string>

    <!-- FAST Stroke Protocol -->
    <string name="emergency_fast_header">🧠 F.A.S.T. Stroke Assessment</string>
    <string name="emergency_fast_f_title">F - Face</string>
    <string name="emergency_fast_f_desc">Ask them to smile. Does one side of the face droop?</string>
    <string name="emergency_fast_a_title">A - Arms</string>
    <string name="emergency_fast_a_desc">Ask them to raise both arms. Does one drift downward?</string>
    <string name="emergency_fast_s_title">S - Speech</string>
    <string name="emergency_fast_s_desc">Ask them to repeat a simple phrase. Is speech slurred or strange?</string>
    <string name="emergency_fast_t_title">T - Time</string>
    <string name="emergency_fast_t_desc">Time is brain! Call 112/108 immediately if any test fails. Note the onset time.</string>

    <!-- First Aid Protocol -->
    <string name="emergency_first_aid_header">🩹 Concise First-Aid Instructions</string>
    <string name="emergency_fa_heart_title">• Chest Pain / Suspected Heart Attack:</string>
    <string name="emergency_fa_heart_desc">Sit upright in a \'W\' position with knees bent and back supported. Loosen tight collars and belts. Keep patient calm while emergency assistance is en route.</string>
    <string name="emergency_fa_allergy_title">• Anaphylaxis / Severe Allergy:</string>
    <string name="emergency_fa_allergy_desc">If prescribed an epinephrine auto-injector (EpiPen), administer immediately into outer mid-thigh. Lie flat with legs elevated unless vomiting or struggling to breathe.</string>
    <string name="emergency_fa_unconscious_title">• Unconscious &amp; Breathing Normally:</string>
    <string name="emergency_fa_unconscious_desc">Roll into the lateral recovery position to keep airway clear and prevent aspiration. Monitor breathing continuously until medical personnel arrive.</string>

