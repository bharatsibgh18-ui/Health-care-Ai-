    <string name="emergency_red_flags_sub">Acude a urgencias de inmediato si observas cualquiera de estas señales:</string>

    <!-- Red Flag Items -->
    <string name="emergency_sign_chest_title">Dolor intenso en el pecho</string>
    <string name="emergency_sign_chest_desc">Dolor opresivo que se irradia al brazo, hombro, cuello o mandíbula.</string>
    <string name="emergency_sign_breath_title">Falta repentina de aire</string>
    <string name="emergency_sign_breath_desc">Ahogo o incapacidad para completar una frase.</string>
    <string name="emergency_sign_stroke_title">Signos de Ictus (FAST)</string>
    <string name="emergency_sign_stroke_desc">Rostro caído, debilidad en un brazo o dificultad para hablar.</string>
    <string name="emergency_sign_headache_title">Dolor de cabeza súbito extremo</string>
    <string name="emergency_sign_headache_desc">Cefalea intensa que alcanza su máximo en segundos.</string>
    <string name="emergency_sign_bleeding_title">Hemorragia grave o tos con sangre</string>
    <string name="emergency_sign_bleeding_desc">Sangrado incontrolable o hemoptisis.</string>
    <string name="emergency_sign_allergy_title">Signos de anafilaxia</string>
    <string name="emergency_sign_allergy_desc">Hinchazón de labios/lengua, sibilancias, urticaria o mareos.</string>

    <!-- FAST Stroke Protocol -->
    <string name="emergency_fast_header">🧠 Evaluación de Ictus F.A.S.T.</string>
    <string name="emergency_fast_f_title">F - Rostro (Face)</string>
    <string name="emergency_fast_f_desc">Pídele que sonría. ¿Un lado del rostro cae?</string>
    <string name="emergency_fast_a_title">A - Brazos (Arms)</string>
    <string name="emergency_fast_a_desc">Pídele que levante ambos brazos. ¿Uno desciende?</string>
    <string name="emergency_fast_s_title">S - Habla (Speech)</string>
    <string name="emergency_fast_s_desc">Pídele que repita una frase simple. ¿Suena arrastrada?</string>
    <string name="emergency_fast_t_title">T - Tiempo (Time)</string>
    <string name="emergency_fast_t_desc">¡Cada minuto cuenta! Llama al 112/108 inmediatamente.</string>

    <!-- First Aid Protocol -->
    <string name="emergency_first_aid_header">🩹 Primeros Auxilios</string>
    <string name="emergency_fa_heart_title">• Dolor de pecho / Sospecha de infarto:</string>
    <string name="emergency_fa_heart_desc">Siéntate con las rodillas dobladas y la espalda apoyada. Afloja ropa ajustada y mantén la calma.</string>
    <string name="emergency_fa_allergy_title">• Anafilaxia / Alergia grave:</string>
    <string name="emergency_fa_allergy_desc">Si tienes un autoinyector EpiPen recetado, adminístralo inmediatamente en el muslo.</string>
    <string name="emergency_fa_unconscious_title">• Inconsciente pero respirando:</string>
    <string name="emergency_fa_unconscious_desc">Coloca a la persona en posición lateral de seguridad y vigila la respiración.</string>

