    <!-- Red Flag Items -->
    <string name="emergency_sign_chest_title">கடுமையான நெஞ்சு வலி</string>
    <string name="emergency_sign_chest_desc">கை, தோள், கழுத்து அல்லது தாடைக்கு பரவும் அழுத்தமான வலி.</string>
    <string name="emergency_sign_breath_title">திடீர் மூச்சுத்திணறல்</string>
    <string name="emergency_sign_breath_desc">மூச்சு விட சிரமம் அல்லது முழு வாக்கியம் பேச முடியாமை.</string>
    <string name="emergency_sign_stroke_title">பக்கவாத அறிகுறிகள் (FAST)</string>
    <string name="emergency_sign_stroke_desc">முகம் சாய்தல், கை தளர்ச்சி அல்லது பேச்சு குழறுதல்.</string>
    <string name="emergency_sign_headache_title">திடீர் கடுமையான தலைவலி</string>
    <string name="emergency_sign_headache_desc">சில நொடிகளில் தாங்க முடியாத உச்சத்தை அடையும் தலைவலி.</string>
    <string name="emergency_sign_bleeding_title">கடுமையான இரத்தப்போக்கு</string>
    <string name="emergency_sign_bleeding_desc">கட்டுப்படுத்த முடியாத இரத்தப்போக்கு அல்லது இருமலில் இரத்தம்.</string>
    <string name="emergency_sign_allergy_title">கடுமையான ஒவ்வாமை அறிகுறிகள்</string>
    <string name="emergency_sign_allergy_desc">உதடு/நாக்கு வீக்கம், மூச்சுத்திணறல், தடிப்பு அல்லது மயக்கம்.</string>

    <!-- FAST Stroke Protocol -->
    <string name="emergency_fast_header">🧠 F.A.S.T. பக்கவாத பரிசோதனை</string>
    <string name="emergency_fast_f_title">F - முகம் (Face)</string>
    <string name="emergency_fast_f_desc">சிரிக்கச் சொல்லுங்கள். முகத்தின் ஒரு பக்கம் சாய்கிறதா?</string>
    <string name="emergency_fast_a_title">A - கைகள் (Arms)</string>
    <string name="emergency_fast_a_desc">இரு கைகளையும் உயர்த்தச் சொல்லுங்கள். ஒரு கை கீழே விழுகிறதா?</string>
    <string name="emergency_fast_s_title">S - பேச்சு (Speech)</string>
    <string name="emergency_fast_s_desc">எளிய வாக்கியத்தைச் சொல்லச் சொல்லுங்கள். பேச்சு தெளிவில்லாமல் உள்ளதா?</string>
    <string name="emergency_fast_t_title">T - நேரம் (Time)</string>
    <string name="emergency_fast_t_desc">ஒவ்வொரு நொடியும் முக்கியம்! உடனே 112/108 அழைக்கவும்.</string>

    <!-- First Aid Protocol -->
    <string name="emergency_first_aid_header">🩹 முதலுதவி வழிமுறைகள்</string>
    <string name="emergency_fa_heart_title">• நெஞ்சு வலி / மாரடைப்பு சந்தேகம்:</string>
    <string name="emergency_fa_heart_desc">முழங்கால்களை மடித்து முதுகுக்கு ஆதரவுடன் நிமிர்ந்து அமரவும். இறுக்கமான உடையை தளர்த்தவும்.</string>
    <string name="emergency_fa_allergy_title">• கடுமையான ஒவ்வாமை (Anaphylaxis):</string>
    <string name="emergency_fa_allergy_desc">பரிந்துரைக்கப்பட்ட EpiPen இருந்தால் உடனே தொடையில் செலுத்தவும்.</string>
    <string name="emergency_fa_unconscious_title">• மயக்கம் ஆனால் சுவாசம் இயல்பு:</string>
    <string name="emergency_fa_unconscious_desc">சுவாசப்பாதை திறந்திருக்க ஒரு பக்கமாக படுக்க வைத்து சுவாசத்தைக் கண்காணிக்கவும்.</string>

